<?php
/**
 * @var $block \Vendor\ProductQnA\Block\Customer\Questions
 */
?>
<div class="table-wrapper questions-items">
    <table class="data table table-questions-items" id="my-questions-table">
        <caption class="table-caption"><?= $block->escapeHtml(__('My Questions')) ?></caption>
        <thead>
            <tr>
                <th scope="col" class="col product"><?= $block->escapeHtml(__('Product')) ?></th>
                <th scope="col" class="col question"><?= $block->escapeHtml(__('Question')) ?></th>
                <th scope="col" class="col status"><?= $block->escapeHtml(__('Status')) ?></th>
                <th scope="col" class="col date"><?= $block->escapeHtml(__('Date')) ?></th>
                <th scope="col" class="col actions"><?= $block->escapeHtml(__('Action')) ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($block->getQuestions() as $question): ?>
                <?php
                    $product = $block->getProduct((int)$question->getProductId());
                    $answer = $block->getAnswer((int)$question->getQuestionId());
                    $hasAnswer = $answer !== null;
                    $displayStatus = $hasAnswer ? 'answered' : $question->getStatus();
                ?>
                <tr class="question-item <?= $block->escapeHtmlAttr($block->getStatusClass($displayStatus)) ?>">
                    <td data-th="<?= $block->escapeHtmlAttr(__('Product')) ?>" class="col product">
                        <?php if ($product): ?>
                            <a href="<?= $block->escapeUrl($product->getProductUrl()) ?>" class="product-item-link">
                                <?= $block->escapeHtml($product->getName()) ?>
                            </a>
                        <?php else: ?>
                            <span class="product-unavailable"><?= $block->escapeHtml(__('Product no longer available')) ?></span>
                        <?php endif; ?>
                    </td>
                    <td data-th="<?= $block->escapeHtmlAttr(__('Question')) ?>" class="col question">
                        <div class="question-text">
                            <?= $block->escapeHtml($question->getQuestionText()) ?>
                        </div>
                        <?php if ($hasAnswer): ?>
                            <div class="answer-preview">
                                <strong><?= $block->escapeHtml(__('Answer:')) ?></strong>
                                <p><?= $block->escapeHtml($answer->getAnswerText()) ?></p>
                                <?php if ($answer->getAnsweredBy()): ?>
                                    <p class="answered-by">
                                        <small>
                                            <?= $block->escapeHtml(__('Answered by: %1 on %2', $answer->getAnsweredBy(), $block->formatDate($answer->getAnswerDate()))) ?>
                                        </small>
                                    </p>
                                <?php endif; ?>
                            </div>
                        <?php endif; ?>
                    </td>
                    <td data-th="<?= $block->escapeHtmlAttr(__('Status')) ?>" class="col status">
                        <span class="status-badge <?= $block->escapeHtmlAttr($block->getStatusClass($displayStatus)) ?>">
                            <span class="status-icon"><?= /* @noEscape */ $block->getStatusIcon($displayStatus) ?></span>
                            <span class="status-label"><?= $block->escapeHtml($block->getStatusLabel($displayStatus)) ?></span>
                        </span>
                        <?php if ($displayStatus === 'pending'): ?>
                            <div class="status-message">
                                <small><?= $block->escapeHtml(__('Awaiting admin approval')) ?></small>
                            </div>
                        <?php elseif ($displayStatus === 'approved' && !$hasAnswer): ?>
                            <div class="status-message">
                                <small><?= $block->escapeHtml(__('Published, awaiting answer')) ?></small>
                            </div>
                        <?php elseif ($displayStatus === 'rejected'): ?>
                            <div class="status-message">
                                <small><?= $block->escapeHtml(__('Not approved for publication')) ?></small>
                            </div>
                        <?php endif; ?>
                    </td>
                    <td data-th="<?= $block->escapeHtmlAttr(__('Date')) ?>" class="col date">
                        <?= $block->escapeHtml($block->formatDate($question->getCreatedAt())) ?>
                    </td>
                    <td data-th="<?= $block->escapeHtmlAttr(__('Action')) ?>" class="col actions">
                        <?php if ($product): ?>
                            <a href="<?= $block->escapeUrl($product->getProductUrl()) ?>#product-qna" class="action view">
                                <span><?= $block->escapeHtml(__('View on Product Page')) ?></span>
                            </a>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
</div>

<div class="legend-status">
    <h3><?= $block->escapeHtml(__('Status Legend:')) ?></h3>
    <ul class="status-legend">
        <li>
            <span class="status-badge status-pending">
                <span class="status-icon">⏱</span>
                <span class="status-label"><?= $block->escapeHtml(__('Pending')) ?></span>
            </span>
            <span class="status-description"><?= $block->escapeHtml(__('Awaiting admin approval')) ?></span>
        </li>
        <li>
            <span class="status-badge status-approved">
                <span class="status-icon">✓</span>
                <span class="status-label"><?= $block->escapeHtml(__('Approved')) ?></span>
            </span>
            <span class="status-description"><?= $block->escapeHtml(__('Published, awaiting answer')) ?></span>
        </li>
        <li>
            <span class="status-badge status-answered">
                <span class="status-icon">✓✓</span>
                <span class="status-label"><?= $block->escapeHtml(__('Answered')) ?></span>
            </span>
            <span class="status-description"><?= $block->escapeHtml(__('Received official answer')) ?></span>
        </li>
        <li>
            <span class="status-badge status-rejected">
                <span class="status-icon">✗</span>
                <span class="status-label"><?= $block->escapeHtml(__('Rejected')) ?></span>
            </span>
            <span class="status-description"><?= $block->escapeHtml(__('Not approved for publication')) ?></span>
        </li>
    </ul>
</div>

